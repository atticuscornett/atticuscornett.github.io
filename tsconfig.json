// @migration-task `rewriteRelativeImportExtensions` causes subpath imports with a `.ts` extension (`#lib/index.ts`) to report a type error (TS2877) and should be removed
{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src",
		"vite.config.ts"
	]
}
